@page "/"
@rendermode InteractiveServer

<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<PageTitle>Design System ANM</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true" Style="font-weight:700;color:var(--mud-palette-primary)">
    Design System ANM — SIGBM 2.0
</MudText>
<MudText Typo="Typo.body1" Class="mb-6" Style="max-width:680px">
    Biblioteca de componentes, tokens e padrões visuais da Agência Nacional de Mineração.
    Use os itens do menu para explorar cores, tipografia, componentes e exemplos de uso.
</MudText>

<MudDivider Class="mb-6" />

<MudGrid>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="1" Style="height:100%">
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.ColorLens" Color="Color.Primary" Class="mb-2" Style="font-size:2rem" />
                <MudText Typo="Typo.h6" GutterBottom="true">Cores</MudText>
                <MudText Typo="Typo.body2">Paleta primária (azul), secundária (verde) e destaque (amarelo), com tokens semânticos.</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/ds/cores">Ver paleta</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="1" Style="height:100%">
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.TextFields" Color="Color.Primary" Class="mb-2" Style="font-size:2rem" />
                <MudText Typo="Typo.h6" GutterBottom="true">Tipografia</MudText>
                <MudText Typo="Typo.body2">Escala tipográfica com Inter, de H1 (48px) a Caption (12px).</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/ds/tipografia">Ver tipografia</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="1" Style="height:100%">
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.SmartButton" Color="Color.Primary" Class="mb-2" Style="font-size:2rem" />
                <MudText Typo="Typo.h6" GutterBottom="true">Botões</MudText>
                <MudText Typo="Typo.body2">6 variantes × 3 tamanhos: Filled, Outlined, Text, IconButton e estados.</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/ds/botoes">Ver botões</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="1" Style="height:100%">
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.EditNote" Color="Color.Primary" Class="mb-2" Style="font-size:2rem" />
                <MudText Typo="Typo.h6" GutterBottom="true">Formulários</MudText>
                <MudText Typo="Typo.body2">Inputs, selects, checkboxes, date pickers com 8 estados visuais.</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/ds/formularios">Ver formulários</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="1" Style="height:100%">
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.TableChart" Color="Color.Primary" Class="mb-2" Style="font-size:2rem" />
                <MudText Typo="Typo.h6" GutterBottom="true">Tabelas</MudText>
                <MudText Typo="Typo.body2">Tabelas com ordenação, paginação, filtros e seleção de linha.</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/ds/tabelas">Ver tabelas</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="1" Style="height:100%">
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.ViewAgenda" Color="Color.Primary" Class="mb-2" Style="font-size:2rem" />
                <MudText Typo="Typo.h6" GutterBottom="true">Cards</MudText>
                <MudText Typo="Typo.body2">Cards de conteúdo, métricas e alertas para dashboards.</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/ds/cards">Ver cards</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>
