@page "/ds/tipografia"
@rendermode InteractiveServer

<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<PageTitle>Tipografia — Design System ANM</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true" Style="font-weight:700">Tipografia</MudText>
<MudText Typo="Typo.body2" Class="mb-6">Escala tipográfica baseada na fonte <b>Inter</b>, com base 16px e espaçamento de linha 1.5.</MudText>

<MudPaper Elevation="0" Class="pa-6" Style="background:#F5F7FA;border-radius:8px">
    <MudText Typo="Typo.h1" GutterBottom="true">H1 — 48px Bold</MudText>
    <MudDivider Class="mb-4" />
    <MudText Typo="Typo.h2" GutterBottom="true">H2 — 36px Bold</MudText>
    <MudDivider Class="mb-4" />
    <MudText Typo="Typo.h3" GutterBottom="true">H3 — 30px SemiBold</MudText>
    <MudDivider Class="mb-4" />
    <MudText Typo="Typo.h4" GutterBottom="true">H4 — 24px SemiBold</MudText>
    <MudDivider Class="mb-4" />
    <MudText Typo="Typo.h5" GutterBottom="true">H5 — 20px SemiBold</MudText>
    <MudDivider Class="mb-4" />
    <MudText Typo="Typo.h6" GutterBottom="true">H6 — 18px SemiBold</MudText>
    <MudDivider Class="mb-4" />
    <MudText Typo="Typo.body1" GutterBottom="true">Body 1 — 16px Regular. Texto principal de conteúdo e descrições.</MudText>
    <MudDivider Class="mb-4" />
    <MudText Typo="Typo.body2" GutterBottom="true">Body 2 — 14px Regular. Texto secundário, labels e metadados.</MudText>
    <MudDivider Class="mb-4" />
    <MudText Typo="Typo.caption" GutterBottom="true">Caption — 12px Regular. Legendas, tooltips e notas de rodapé.</MudText>
    <MudDivider Class="mb-4" />
    <MudText Typo="Typo.button" GutterBottom="true">Button — 14px SemiBold. Texto de botões e ações.</MudText>
</MudPaper>
